# Copy to .env (or run: python3 scripts/setup_env.py). NEVER commit the real .env file.
# Login passwords (8+ characters) for the three accounts: admin, staff, student
DORM_ADMIN_PASSWORD=change-me-admin
DORM_STAFF_PASSWORD=change-me-staff
DORM_STUDENT_PASSWORD=change-me-student
# 32-byte AES-256 key, base64. Encrypts IIN, national ID and passport numbers in the database.
# If you lose this key, those values cannot be read again.
DORM_ENCRYPTION_KEY=generate-with-setup_env.py
